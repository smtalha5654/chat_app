rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isMe(userId);
      allow delete: if false;
    }

    match /chats/{chatId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }

      function isIncomingParticipant() {
        return signedIn() && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isParticipant();
      allow create: if isIncomingParticipant()
        && request.resource.data.participants.size() == 2;
      allow update: if isParticipant() && isIncomingParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        function chatPath() {
          return /databases/$(database)/documents/chats/$(chatId);
        }

        function isChatParticipant() {
          return signedIn() && (
            (exists(chatPath()) && request.auth.uid in get(chatPath()).data.participants)
            || (existsAfter(chatPath()) && request.auth.uid in getAfter(chatPath()).data.participants)
          );
        }

        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isChatParticipant()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
