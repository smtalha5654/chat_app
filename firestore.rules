rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isMe(userId);
      allow delete: if false;
    }

    match /chats/{chatId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }

      function isIncomingParticipant() {
        return signedIn() && request.auth.uid in request.resource.data.participants;
      }

      // chatId is "{uidA}_{uidB}" with the two ids sorted.
      function belongsToChatId() {
        return signedIn() && (
          chatId.matches(request.auth.uid + '_.*')
          || chatId.matches('.*_' + request.auth.uid)
        );
      }

      allow read: if isParticipant();
      allow create: if isIncomingParticipant()
        && belongsToChatId()
        && request.resource.data.participants.size() == 2;
      allow update: if isParticipant() && isIncomingParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        function chatPath() {
          return /databases/$(database)/documents/chats/$(chatId);
        }

        function isExistingChatParticipant() {
          return exists(chatPath())
            && request.auth.uid in get(chatPath()).data.participants;
        }

        function isChatParticipantAfterWrite() {
          return existsAfter(chatPath())
            && request.auth.uid in getAfter(chatPath()).data.participants;
        }

        allow read: if belongsToChatId();
        allow create: if belongsToChatId()
          && request.resource.data.senderId == request.auth.uid
          && (isExistingChatParticipant() || isChatParticipantAfterWrite());
        allow update, delete: if belongsToChatId()
          && isExistingChatParticipant()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
